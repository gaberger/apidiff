{
  "name": "Integration",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "base_url": {
      "type": "string",
      "description": "Base URL or GitHub repo URL for spec discovery"
    },
    "changelog_url": {
      "type": "string",
      "description": "Optional changelog URL for version extraction"
    },
    "versions": {
      "type": "array",
      "description": "All discovered individual spec versions",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "v1_url": {
            "type": "string"
          },
          "v2_url": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ]
}