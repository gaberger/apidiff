# APIDIFF environment template.
# Copy to env.local (gitignored) and fill in real values.

# --- Browser-safe (Vite will bundle VITE_* into the client) -------------------
# Both reachable from src/adapters/secondary/supabase/client.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Either of the above satisfies the client; publishable key is an accepted alias.
# VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only (NEVER expose these to the browser bundle) -------------------
# Read only by Vercel serverless functions under api/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=

POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# --- Optional ---------------------------------------------------------------
# GITHUB_TOKEN=
