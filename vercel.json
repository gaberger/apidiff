{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx -y bun@1.4.0 install --frozen-lockfile",
  "buildCommand": "bun run build:site",
  "outputDirectory": "site-dist",
  "rewrites": [
    {
      "source": "/changeset-spec",
      "destination": "/index.html"
    },
    {
      "source": "/tools",
      "destination": "/index.html"
    }
  ]
}
